# Neon Postgres (pooled connection string)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# Test database. Tests TRUNCATE every table, so this MUST be a separate Neon
# branch — never the same value as DATABASE_URL. Leave it unset to run the suite
# against a throwaway in-memory PGlite database instead.
# TEST_DATABASE_URL=postgresql://user:pass@ep-yyy-pooler.region.aws.neon.tech/db?sslmode=require

# Auth.js
AUTH_SECRET=replace-with-openssl-rand-base64-32-output
AUTH_URL=http://localhost:3000

# First admin (seeded on first DB boot, then ignored)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_DISPLAY_NAME=관리자

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=family-gallery
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
